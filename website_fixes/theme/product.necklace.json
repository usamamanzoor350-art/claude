        "text_WBkbUV": {
          "type": "text",
          "settings": {
            "text": "A Birthstone Birthday Necklace is a personalized piece of jewelry that celebrates the uniqueness of each individual by featuring their birthstone, representing the month of their birth. Each birthstone has its own significance and meaning, making these necklaces a thoughtful and sentimental gift for birthdays or other special occasions.",
            "text_style": "body"
          }
        },
        "ff32ea77-bcea-43d3-8e38-55894c9d938a": {
          "type": "separator",
          "settings": {}
        },
        "8288910a-1ad6-47df-b127-118bc1d2ce24": {
          "type": "buttons",
          "settings": {
            "enable_local_pickup": true,
            "enable_hurrify": false,
            "enable_payment_button": false,
            "waitlist": false,
            "product_selector": "radio",
            "sw_color_product": true,
            "color_circle": true,
            "size_color": "small-38"
          }
        },
        "tabcustom_tW9YNw": {
          "type": "tabcustom",
          "settings": {
            "title_tab": "Shipping & Delivery",
            "icon": "none",
            "answer_content": "<p>Each stone is checked under magnification and set by hand into its prong upon order. Please allow 10–15 business days for our team to carefully craft and inspect your necklace before it ships.</p>",
            "page": ""
          }
        },
        "tabcustom_BmLLTD": {
          "type": "tabcustom",
          "settings": {
            "title_tab": "Care & Materials",
            "icon": "none",
            "answer_content": "<p>Made with a tarnish-resistant chain designed to survive everyday wear. To keep it shining brightly, avoid wearing it in pools or oceans. Wipe it down with a soft polishing cloth after wear and store it in the provided pouch.</p>",
            "page": ""
          }
        },
        "tabcustom_kKt8qt": {
          "type": "tabcustom",
          "settings": {
            "title_tab": "Frequently Asked Questions",
            "icon": "none",
            "answer_content": "<ul><li><strong>Will the chain turn my neck green?</strong> No. Our chains are crafted from high-quality, tarnish-resistant materials designed for sensitive skin and daily wear.</li><li><strong>Can I add a second birthstone later?</strong> This specific setting is engineered to highlight a single, featured stone in order to maintain its delicate, minimalist aesthetic.</li><li><strong>Does it come in a gift box?</strong> Yes, every necklace arrives beautifully packaged in a custom box, completely ready to be gifted the moment it arrives.</li></ul>",
            "page": ""
          }
        }
      },
