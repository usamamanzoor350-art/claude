        "tabcustom_wLXC4Q": {
          "type": "tabcustom",
          "settings": {
            "title_tab": "Shipping & Delivery",
            "icon": "checkmark",
            "answer_content": "<p>Production takes 10–15 business days because every shirt is custom-printed to order. Once crafted, standard shipping applies. You will receive a tracking number via email the moment your order leaves our facility.</p>",
            "page": ""
          }
        },
        "tabcustom_we48rk": {
          "type": "tabcustom",
          "settings": {
            "title_tab": "Care Instructions",
            "icon": "checkmark",
            "answer_content": "<p>To keep the print looking sharp, machine wash cold, inside-out, on a gentle cycle. Tumble dry on low or hang dry. Do not iron directly over the customized design.</p>",
            "page": ""
          }
        },
        "tabcustom_9WcRqn": {
          "type": "tabcustom",
          "settings": {
            "title_tab": "Frequently Asked Questions",
            "icon": "checkmark",
            "answer_content": "<ul><li><strong>Can I order different sizes for a group?</strong> Yes! Just enter the custom details, select the size, add it to your cart, and repeat the process for each person in your group.</li><li><strong>What if I misspell the destination?</strong> You have a 12-hour window after placing your order to email our support team with corrections before production begins.</li><li><strong>Is the shirt true to size?</strong> Yes, these are unisex classic fit shirts. If you prefer a trendy, oversized look, we recommend sizing up by one or two sizes.</li></ul>",
            "page": ""
          }
        }
      },
