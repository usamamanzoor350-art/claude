        "text_WBkbUV": {
          "type": "text",
          "settings": {
            "text": "Every tote is cut, stitched and personalized by hand  reinforced at every seam for long lasting durability and reliable protection against wear and water. Not a flimsy freebie tote; one built to actually be used.",
            "text_style": "body"
          }
        },
        "ff32ea77-bcea-43d3-8e38-55894c9d938a": {
