            "size_color": "small-38"
          }
        },
        "tabcustom_V8rQac": {
          "type": "tabcustom",
          "settings": {
            "title_tab": "Shipping & Delivery",
            "icon": "none",
            "answer_content": "<p>Because your specific location and name details are printed to order, production takes 10–15 business days. Once your tote passes our quality check, it ships out with full tracking provided directly to your inbox.</p>",
            "page": ""
          }
        },
        "tabcustom_EdGH8K": {
          "type": "tabcustom",
          "settings": {
            "title_tab": "Care & Materials",
            "icon": "none",
            "answer_content": "<p>Crafted from heavy-duty canvas. Spot clean only with mild soap and warm water. Do not machine wash or tumble dry, as this can damage the bag's rigid structure and the custom lettering.</p>",
            "page": ""
          }
        },
        "tabcustom_6HRWeg": {
          "type": "tabcustom",
          "settings": {
            "title_tab": "Frequently Asked Questions",
            "icon": "none",
            "answer_content": "<ul><li><strong>Can I wash this in the washing machine?</strong> We strongly advise against machine washing to preserve the shape of the canvas and the clarity of the personalized print. Spot cleaning is the safest method.</li><li><strong>How much can this bag hold?</strong> The heavy-duty canvas and reinforced stitching are designed to comfortably carry groceries, laptops, beach gear, and daily essentials.</li><li><strong>Can I change the font style?</strong> To maintain the signature, editorial aesthetic of our brand, the font style and layout shown in the photos are standard for all orders.</li></ul>",
            "page": ""
          }
        }
      },
