    "mu_reviews_cHrAPx": {
      "type": "mu-reviews",
      "blocks": {
        "review_kmc4JD": {
          "type": "review",
          "settings": {
            "rating": 5,
            "source": "google",
            "text": "<p>This 60th birthday T-shirt is fantastic! The design is personalized, and the fabric is so soft. It's a fun way to celebrate such a special milestone. Highly recommend!</p>",
            "name": "Anna L.",
            "date": "6 Months Ago"
          }
        },
        "review_BpCJNP": {
          "type": "review",
          "settings": {
            "rating": 5,
            "source": "google",
            "text": "<p>I simply love this 'Queen Is 40' T-shirt! The fabric is soft, the fit is great, and the design is stunning. The perfect birthday gift for my sister – she loved it!</p>",
            "name": "Clara K.",
            "date": "1 Year Ago"
          }
        },
        "review_E6fjHY": {
          "type": "review",
          "settings": {
            "rating": 5,
            "source": "google",
            "text": "<p>This sweatshirt is perfect for my 45th birthday! The fabric is super soft, and the custom design makes it special. Great quality and a fun way to celebrate!</p>",
            "name": "Emma M.",
            "date": "5 Years Ago"
          }
        },
        "review_R7WkG8": {
          "type": "review",
          "settings": {
            "rating": 5,
            "source": "google",
            "text": "<p>Ordered the vintage 1975 tee for my husband's 50th and he hasn't taken it off since. The print looks great after several washes and shipping was quick.</p>",
            "name": "Sophie R.",
            "date": "3 Months Ago"
          }
        },
        "review_WtainT": {
          "type": "review",
          "settings": {
            "rating": 5,
            "source": "google",
            "text": "<p>We got matching 'Queen' shirts for my mom's 70th birthday party. Everyone asked where they were from. True to size and really comfortable!</p>",
            "name": "Laura B.",
            "date": "8 Months Ago"
          }
        },
        "review_fHPkRn": {
          "type": "review",
          "settings": {
            "rating": 5,
            "source": "google",
            "text": "<p>Such a thoughtful gift for my best friend's 30th. The colors are bright, the cotton feels premium, and it arrived beautifully packed. Will order again!</p>",
            "name": "Mia T.",
            "date": "2 Weeks Ago"
          }
        }
      },
